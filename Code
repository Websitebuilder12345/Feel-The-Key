<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Accessible Audio Piano - 11 Song Master Collection</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background-color: #121212;
      color: #ffffff;
      padding: 20px;
    }
    .box {
      border: 2px solid #ffffff;
      max-width: 850px;
      margin: 0 auto;
      padding: 25px;
      border-radius: 10px;
    }
    .main-btn {
      font-size: 18px;
      padding: 12px 24px;
      margin: 10px 5px;
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    .demo-btn {
      font-size: 15px;
      padding: 8px 16px;
      background-color: #2196F3;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 10px;
    }
    .song-card {
      background-color: #1e1e1e;
      border: 1px solid #444;
      padding: 15px;
      margin: 15px 0;
      text-align: left;
      border-radius: 8px;
    }
    .notes-list {
      color: #FFD700;
      font-weight: bold;
      font-size: 15px;
      line-height: 1.6;
    }
    .keys-list {
      color: #00E676;
      font-size: 14px;
    }
  </style>
</head>
<body>

  <main class="box">
    <h1>Accessible Audio Piano</h1>
    <p>Enable audio to practice manually or click <strong>"Listen / Auto-Play"</strong> on any song to hear the complete melody played automatically!</p>
    
    <button id="startBtn" class="main-btn">1. Click Here First to Enable Audio</button>
    <button id="stopBtn" class="main-btn" style="background-color: #f44336;">Stop Auto-Play</button>
    
    <div id="status" aria-live="polite" style="font-size: 22px; color: #4CAF50; margin: 15px 0;">
      Status: Waiting for audio activation...
    </div>

    <h2>🎵 Interactive Song Library</h2>

    <section class="song-card">
      <h3>1. Twinkle, Twinkle, Little Star</h3>
      <p class="notes-list">Musical Notes: C4 - C4 - G4 - G4 - A4 - A4 - G4 | F4 - F4 - E4 - E4 - D4 - D4 - C4 | G4 - G4 - F4 - F4 - E4 - E4 - D4 | C4 - C4 - G4 - G4 - A4 - A4 - G4 | F4 - F4 - E4 - E4 - D4 - D4 - C4</p>
      <p class="keys-list">Keyboard Keys: A A G G H H G | F F D D S S A | G G F F D D S | A A G G H H G | F F D D S S A</p>
      <button class="demo-btn" onclick="playSongDemo(twinkleNotes)">▶ Listen / Auto-Play Twinkle Twinkle</button>
    </section>

    <section class="song-card">
      <h3>2. Old MacDonald Had a Farm</h3>
      <p class="notes-list">Musical Notes: G4 - G4 - G4 - C4 - D4 - D4 - C4 | E4 - E4 - D4 - D4 - C4 | G4 - G4 - G4 - C4 - D4 - D4 - C4 | E4 - E4 - D4 - D4 - C4</p>
      <p class="keys-list">Keyboard Keys: G G G A S S A | D D S S A | G G G A S S A | D D S S A</p>
      <button class="demo-btn" onclick="playSongDemo(macdonaldNotes)">▶ Listen / Auto-Play Old MacDonald</button>
    </section>

    <section class="song-card">
      <h3>3. Für Elise - L. v. Beethoven (Main Theme)</h3>
      <p class="notes-list">Musical Notes: E5 - D#5 - E5 - D#5 - E5 - B4 - D5 - C5 - A4 | C4 - E4 - A4 - B4 | E4 - G#4 - B4 - C5</p>
      <p class="keys-list">Keyboard Keys: O W O W O J L K H | A D H J | D R J K</p>
      <button class="demo-btn" onclick="playSongDemo(furEliseNotes)">▶ Listen / Auto-Play Für Elise</button>
    </section>

    <section class="song-card">
      <h3>4. Nocturne Op. 9 No. 2 - F. Chopin (Opening Theme)</h3>
      <p class="notes-list">Musical Notes: Bb4 - G5 - F5 - G5 - Eb5 - Bb4 - G4 - Ab4 - Bb4 - Eb5 | C5 - Bb4 - Ab4 - G4 - F4 - Eb4</p>
      <p class="keys-list">Keyboard Keys: U I P I W U G R U W | K U R G F E</p>
      <button class="demo-btn" onclick="playSongDemo(chopinNotes)">▶ Listen / Auto-Play Chopin Nocturne</button>
    </section>

    <section class="song-card">
      <h3>5. Prelude in C Major - J.S. Bach</h3>
      <p class="notes-list">Musical Notes: C4 - E4 - G4 - C5 - E5 | C4 - E4 - G4 - C5 - E5 | C4 - D4 - A4 - D5 - F5 | C4 - D4 - A4 - D5 - F5</p>
      <p class="keys-list">Keyboard Keys: A D G K O | A D G K O | A S H L P | A S H L P</p>
      <button class="demo-btn" onclick="playSongDemo(bachNotes)">▶ Listen / Auto-Play Prelude in C</button>
    </section>

    <section class="song-card">
      <h3>6. Turkish March - W.A. Mozart</h3>
      <p class="notes-list">Musical Notes: B4 - A4 - G#4 - A4 - C5 | D5 - C5 - B4 - C5 - E5 | F5 - E5 - D#5 - E5 - B5</p>
      <p class="keys-list">Keyboard Keys: J H R H K | L K J K O | P O W O B</p>
      <button class="demo-btn" onclick="playSongDemo(mozartNotes)">▶ Listen / Auto-Play Turkish March</button>
    </section>

    <section class="song-card">
      <h3>7. The Entertainer - Scott Joplin</h3>
      <p class="notes-list">Musical Notes: D4 - D#4 - E4 - C5 - E4 - C5 - E4 - C5 | D4 - D#4 - E4 - C5 - E4 - C5 - E4 - C5</p>
      <p class="keys-list">Keyboard Keys: S E D K D K D K | S E D K D K D K</p>
      <button class="demo-btn" onclick="playSongDemo(entertainerNotes)">▶ Listen / Auto-Play The Entertainer</button>
    </section>

    <section class="song-card">
      <h3>8. Moonlight Sonata - L. v. Beethoven</h3>
      <p class="notes-list">Musical Notes: G#4 - C#5 - E5 | G#4 - C#5 - E5 | G#4 - C#5 - E5 | A4 - C#5 - E5 | A4 - D5 - F5</p>
      <p class="keys-list">Keyboard Keys: R Y O | R Y O | R Y O | H Y O | H L P</p>
      <button class="demo-btn" onclick="playSongDemo(moonlightNotes)">▶ Listen / Auto-Play Moonlight Sonata</button>
    </section>

    <section class="song-card">
      <h3>9. Clair de Lune - Claude Debussy</h3>
      <p class="notes-list">Musical Notes: F5 - D#5 - C#5 - C5 | Bb4 - G#4 - D#4 - F4</p>
      <p class="keys-list">Keyboard Keys: P W Y K | U R E F</p>
      <button class="demo-btn" onclick="playSongDemo(debussyNotes)">▶ Listen / Auto-Play Clair de Lune</button>
    </section>

    <section class="song-card">
      <h3>10. River Flows in You - Yiruma</h3>
      <p class="notes-list">Musical Notes: A4 - G#4 - A4 - G#4 - A4 - E5 - A4 - C#5 - B4 | A4 - G#4 - A4 - G#4 - A4 - E5 - A4 - C#5 - B4</p>
      <p class="keys-list">Keyboard Keys: H R H R H O H Y J | H R H R H O H Y J</p>
      <button class="demo-btn" onclick="playSongDemo(yirumaNotes)">▶ Listen / Auto-Play River Flows in You</button>
    </section>

    <section class="song-card">
      <h3>11. Mia & Sebastian's Theme (La La Land)</h3>
      <p class="notes-list">Musical Notes: F#4 - B4 - C#5 - D5 | F#5 - E5 - D5 - C#5 - B4 | F#4 - B4 - C#5 - D5 | F#5 - E5 - D5 - C#5 - B4</p>
      <p class="keys-list">Keyboard Keys: T J Y L | X O L Y J | T J Y L | X O L Y J</p>
      <button class="demo-btn" onclick="playSongDemo(lalandNotes)">▶ Listen / Auto-Play Mia & Sebastian's Theme</button>
    </section>
  </main>

  <script>
    let audioCtx;
    let isPlayingDemo = false;

    // Full Dictionary mapping keyboard keys to exact musical names & frequencies
    const notes = {
      'a': { name: 'C4',        freq: 261.63 },
      'q': { name: 'C#4 / Db4', freq: 277.18 },
      's': { name: 'D4',        freq: 293.66 },
      'e': { name: 'Eb4 / D#4', freq: 311.13 },
      'd': { name: 'E4',        freq: 329.63 },
      'f': { name: 'F4',        freq: 349.23 },
      't': { name: 'F#4 / Gb4', freq: 369.99 },
      'g': { name: 'G4',        freq: 392.00 },
      'r': { name: 'G#4 / Ab4', freq: 415.30 },
      'h': { name: 'A4',        freq: 440.00 },
      'u': { name: 'Bb4 / A#4', freq: 466.16 },
      'j': { name: 'B4',        freq: 493.88 },
      'k': { name: 'C5',        freq: 523.25 },
      'y': { name: 'C#5 / Db5', freq: 554.37 },
      'l': { name: 'D5',        freq: 587.33 },
      'w': { name: 'D#5 / Eb5', freq: 622.25 },
      'o': { name: 'E5',        freq: 659.25 },
      'p': { name: 'F5',        freq: 698.46 },
      'x': { name: 'F#5 / Gb5', freq: 739.99 },
      'i': { name: 'G5',        freq: 783.99 },
      'z': { name: 'G#5 / Ab5', freq: 830.61 },
      'v': { name: 'A5',        freq: 880.00 },
      'b': { name: 'B5',        freq: 987.77 }
    };

    // Full Song Sequences for Auto-Playback
    const twinkleNotes = ['a','a','g','g','h','h','g','f','f','d','d','s','s','a','g','g','f','f','d','d','s','a','a','g','g','h','h','g','f','f','d','d','s','s','a'];
    const macdonaldNotes = ['g','g','g','a','s','s','a','d','d','s','s','a','g','g','g','a','s','s','a','d','d','s','s','a'];
    const furEliseNotes = ['o','w','o','w','o','j','l','k','h','a','d','h','j','d','r','j','k'];
    const chopinNotes = ['u','i','p','i','w','u','g','r','u','w','k','u','r','g','f','e'];
    const bachNotes = ['a','d','g','k','o','a','d','g','k','o','a','s','h','l','p','a','s','h','l','p'];
    const mozartNotes = ['j','h','r','h','k','l','k','j','k','o','p','o','w','o','b'];
    const entertainerNotes = ['s','e','d','k','d','k','d','k','s','e','d','k','d','k','d','k'];
    const moonlightNotes = ['r','y','o','r','y','o','r','y','o','h','y','o','h','l','p'];
    const debussyNotes = ['p','w','y','k','u','r','e','f'];
    const yirumaNotes = ['h','r','h','r','h','o','h','y','j','h','r','h','r','h','o','h','y','j'];
    const lalandNotes = ['t','j','y','l','x','o','l','y','j','t','j','y','l','x','o','l','y','j'];

    // Enable Web Audio
    document.getElementById('startBtn').addEventListener('click', initAudio);
    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      document.getElementById('status').innerText = 'Audio Ready! Play manually or click an Auto-Play button.';
    }

    // Stop Button
    document.getElementById('stopBtn').addEventListener('click', () => {
      isPlayingDemo = false;
      window.speechSynthesis.cancel();
      document.getElementById('status').innerText = 'Auto-Play stopped.';
    });

    // Tone Generator
    function playTone(freq) {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      
      osc.start();
      gain.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + 1.0);
      osc.stop(audioCtx.currentTime + 1.0);
    }

    // Voice Announcement
    function speakNote(noteName) {
      const speech = new SpeechSynthesisUtterance(noteName);
      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(speech);
    }

    // Trigger Single Note
    function triggerNote(key) {
      if (notes[key]) {
        playTone(notes[key].freq);
        speakNote(notes[key].name);
        document.getElementById('status').innerText = `Played Note: ${notes[key].name}`;
      }
    }

    // Key Press Listener
    window.addEventListener('keydown', (e) => {
      if (!isPlayingDemo) {
        initAudio();
        triggerNote(e.key.toLowerCase());
      }
    });

    // Auto-Play Function
    async function playSongDemo(songArray) {
      initAudio();
      isPlayingDemo = true;
      
      for (let i = 0; i < songArray.length; i++) {
        if (!isPlayingDemo) break;
        
        const key = songArray[i];
        triggerNote(key);
        
        await new Promise(resolve => setTimeout(resolve, 600));
      }
      
      if (isPlayingDemo) {
        document.getElementById('status').innerText = 'Finished playing song demo!';
        isPlayingDemo = false;
      }
    }
  </script>
</body>
</html>
